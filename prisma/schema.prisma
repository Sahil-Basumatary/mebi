// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  BUILDER
  SPECIALIST
  LEARNER
}

enum ProjectVisibility {
  PUBLIC
  PRIVATE
}

enum ProjectStatus {
  ACTIVE
  COMPLETED
}

enum ProjectRole {
  OWNER
  MEMBER
}

enum RequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

enum ProjectRequestKind {
  JOIN
  INVITE
}

enum NotificationType {
  REQUEST_RECEIVED
  REQUEST_ACCEPTED
  REQUEST_DECLINED
}

enum ThemePreference {
  LIGHT
  DARK
  SYSTEM
}

enum StartupPreference {
  HOME
  LAST_VISITED
}

model User {
  id               String               @id @default(cuid())
  clerkId          String               @unique
  email            String               @unique
  fullName         String?
  username         String?
  bio              String?
  pronouns         String?
  imageUrl         String?
  githubUsername   String?
  showGithub       Boolean              @default(true)
  socialLinks      String[]             @default([])
  themePreference  ThemePreference      @default(LIGHT)
  spellcheckerLanguage String            @default("en-GB")
  timezone         String               @default("auto")
  startupPreference StartupPreference   @default(HOME)
  lastVisitedPath  String?
  cookieConsentAt  DateTime?
  cookiePreferences Boolean             @default(false)
  cookieAnalytics  Boolean              @default(false)
  cookieMarketing  Boolean              @default(false)
  skills           String[]             @default([])
  interests        String[]             @default([])
  role             UserRole?
  prefersSolo      Boolean              @default(false)
  profilePrivate   Boolean              @default(false)
  onboarded        Boolean              @default(false)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  projects         Project[]
  memberships      ProjectMember[]
  sentRequests     ProjectRequest[] @relation("SentProjectRequests")
  receivedRequests ProjectRequest[] @relation("ReceivedProjectRequests")
  notifications    Notification[]
  shortcutBindings UserShortcutBinding[]
}

// One row per remapped action. Missing rows mean "use the product default".
model UserShortcutBinding {
  id        String   @id @default(cuid())
  userId    String
  actionId  String
  combo     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, actionId])
  @@index([userId])
}

model Project {
  id            String            @id @default(cuid())
  ownerId       String
  name          String
  description   String
  techStack     String[]          @default([])
  estimatedTime String?
  visibility    ProjectVisibility @default(PUBLIC)
  status        ProjectStatus     @default(ACTIVE)
  progress      Int               @default(0)
  completedAt   DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  owner         User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members       ProjectMember[]
  requests      ProjectRequest[]

  @@index([ownerId, status])
  @@index([visibility, status])
}

// ownerId stays on Project as the cascade/accountable owner; the owner also
// always has a ProjectMember row with role OWNER so "projects I'm in" is one query.
model ProjectMember {
  id        String      @id @default(cuid())
  projectId String
  userId    String
  role      ProjectRole @default(MEMBER)
  joinedAt  DateTime    @default(now())
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

model ProjectRequest {
  id              String             @id @default(cuid())
  fromUserId      String
  toUserId        String
  projectId       String
  kind            ProjectRequestKind
  message         String
  sharedSkills    String[]           @default([])
  sharedInterests String[]           @default([])
  note            String?
  status          RequestStatus      @default(PENDING)
  createdAt       DateTime           @default(now())
  respondedAt     DateTime?
  fromUser        User               @relation("SentProjectRequests", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser          User               @relation("ReceivedProjectRequests", fields: [toUserId], references: [id], onDelete: Cascade)
  project         Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([toUserId, status])
  @@index([fromUserId, status])
  @@index([projectId, status])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  message   String
  actorName String?
  requestId String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}
