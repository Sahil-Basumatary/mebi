// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  BUILDER
  SPECIALIST
  LEARNER
}

enum ProjectVisibility {
  PUBLIC
  PRIVATE
}

enum ProjectStatus {
  ACTIVE
  COMPLETED
}

enum ProjectRole {
  OWNER
  MEMBER
}

enum RequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

enum ProjectRequestKind {
  JOIN
  INVITE
}

enum NotificationType {
  REQUEST_RECEIVED
  REQUEST_ACCEPTED
  REQUEST_DECLINED
  FORUM_REPLY
  PROJECT_UPDATE
  PROJECT_SIGNED
}

enum ThemePreference {
  LIGHT
  DARK
  SYSTEM
}

enum StartupPreference {
  HOME
  LAST_VISITED
}

model User {
  id               String               @id @default(cuid())
  clerkId          String               @unique
  email            String               @unique
  fullName         String?
  username         String?              @unique
  bio              String?
  pronouns         String?
  imageUrl         String?
  githubUsername   String?
  showGithub       Boolean              @default(true)
  linkedinUrl      String?
  showLinkedin     Boolean              @default(true)
  discordHandle    String?
  showDiscord      Boolean              @default(true)
  calendarUrl      String?
  showCalendar     Boolean              @default(true)
  socialLinks      String[]             @default([])
  themePreference  ThemePreference      @default(LIGHT)
  spellcheckerLanguage String            @default("en-GB")
  timezone         String               @default("auto")
  startupPreference StartupPreference   @default(HOME)
  lastVisitedPath  String?
  cookieConsentAt  DateTime?
  cookiePreferences Boolean             @default(false)
  cookieAnalytics  Boolean              @default(false)
  cookieMarketing  Boolean              @default(false)
  skills           String[]             @default([])
  interests        String[]             @default([])
  role             UserRole?
  prefersSolo      Boolean              @default(false)
  profilePrivate   Boolean              @default(false)
  notifyInbox      Boolean              @default(true)
  notifyProjectActivity Boolean         @default(true)
  notifyWeeklyDigest Boolean            @default(false)
  notifyMarketing  Boolean              @default(false)
  lastDigestAt     DateTime?
  lastMarketingAt  DateTime?
  onboarded        Boolean              @default(false)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  projects         Project[]
  memberships      ProjectMember[]
  projectUpdates   ProjectUpdate[]
  signaturesGiven  ProofSignature[] @relation("SignaturesGiven")
  signaturesReceived ProofSignature[] @relation("SignaturesReceived")
  sentRequests     ProjectRequest[] @relation("SentProjectRequests")
  receivedRequests ProjectRequest[] @relation("ReceivedProjectRequests")
  notifications    Notification[]
  shortcutBindings UserShortcutBinding[]
  forumThreads     ForumThread[]        @relation("ForumThreadsAuthored")
  forumLastPosts   ForumThread[]        @relation("ForumThreadsLastPoster")
  forumPosts       ForumPost[]          @relation("ForumPostsAuthored")
  forumVotes       ForumPostVote[]
}

// One row per remapped action. Missing rows mean "use the product default".
model UserShortcutBinding {
  id        String   @id @default(cuid())
  userId    String
  actionId  String
  combo     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, actionId])
  @@index([userId])
}

model Project {
  id            String            @id @default(cuid())
  ownerId       String
  name          String
  description   String
  techStack     String[]          @default([])
  estimatedTime String?
  visibility    ProjectVisibility @default(PUBLIC)
  status        ProjectStatus     @default(ACTIVE)
  progress      Int               @default(0)
  completedAt   DateTime?
  slug          String?           @unique
  summary       String?
  publishedAt   DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  owner         User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members       ProjectMember[]
  updates       ProjectUpdate[]
  signatures    ProofSignature[]
  requests      ProjectRequest[]
  forumThreads  ForumThread[]

  @@index([ownerId, status])
  @@index([visibility, status])
  @@index([publishedAt])
}

// Real build activity. Progress is optional and only moves when a member posts.
model ProjectUpdate {
  id        String   @id @default(cuid())
  projectId String
  authorId  String
  body      String
  progress  Int?
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([authorId])
}

// ownerId stays on Project as the cascade/accountable owner; the owner also
// always has a ProjectMember row with role OWNER so "projects I'm in" is one query.
model ProjectMember {
  id        String      @id @default(cuid())
  projectId String
  userId    String
  role      ProjectRole @default(MEMBER)
  joinedAt  DateTime    @default(now())
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

model ProjectRequest {
  id              String             @id @default(cuid())
  fromUserId      String
  toUserId        String
  projectId       String
  kind            ProjectRequestKind
  message         String
  sharedSkills    String[]           @default([])
  sharedInterests String[]           @default([])
  note            String?
  status          RequestStatus      @default(PENDING)
  createdAt       DateTime           @default(now())
  respondedAt     DateTime?
  fromUser        User               @relation("SentProjectRequests", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser          User               @relation("ReceivedProjectRequests", fields: [toUserId], references: [id], onDelete: Cascade)
  project         Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([toUserId, status])
  @@index([fromUserId, status])
  @@index([projectId, status])
}

// Signer attests that subject contributed. No self-signing; unlock only after
// the subject has posted real build-log activity on this project.
model ProofSignature {
  id        String    @id @default(cuid())
  projectId String
  signerId  String
  subjectId String
  statement String
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  signer    User      @relation("SignaturesGiven", fields: [signerId], references: [id], onDelete: Cascade)
  subject   User      @relation("SignaturesReceived", fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([projectId, signerId, subjectId])
  @@index([projectId])
  @@index([subjectId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  message   String
  actorName String?
  requestId String?
  href      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

model ForumBoard {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  description String
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  threads     ForumThread[]
}

model ForumThread {
  id               String      @id @default(cuid())
  boardId          String
  authorId         String
  projectId        String?
  title            String
  tags             String[]    @default([])
  locked           Boolean     @default(false)
  replyCount       Int         @default(0)
  viewCount        Int         @default(0)
  lastPostedAt     DateTime    @default(now())
  lastPostAuthorId String?
  lastPostId       String?
  score            Int         @default(0)
  deletedAt        DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  board            ForumBoard  @relation(fields: [boardId], references: [id], onDelete: Restrict)
  author           User        @relation("ForumThreadsAuthored", fields: [authorId], references: [id], onDelete: Cascade)
  lastPostAuthor   User?       @relation("ForumThreadsLastPoster", fields: [lastPostAuthorId], references: [id], onDelete: SetNull)
  project          Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  posts            ForumPost[]

  @@index([boardId, lastPostedAt])
  @@index([boardId, createdAt])
  @@index([authorId, createdAt])
  @@index([deletedAt, lastPostedAt])
  @@index([projectId])
}

model ForumPost {
  id        String          @id @default(cuid())
  threadId  String
  authorId  String
  parentId  String?
  body      String
  score     Int             @default(0)
  editedAt  DateTime?
  deletedAt DateTime?
  createdAt DateTime        @default(now())
  thread    ForumThread     @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author    User            @relation("ForumPostsAuthored", fields: [authorId], references: [id], onDelete: Cascade)
  parent    ForumPost?      @relation("ForumPostReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies   ForumPost[]     @relation("ForumPostReplies")
  votes     ForumPostVote[]

  @@index([threadId, createdAt])
  @@index([authorId])
  @@index([parentId])
}

model ForumPostVote {
  id        String    @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime  @default(now())
  post      ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId])
}

model NewsletterSignup {
  id               String    @id @default(cuid())
  email            String    @unique
  firstName        String
  ipHash           String
  userAgent        String?
  unsubscribeToken String    @unique
  unsubscribedAt   DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([ipHash, updatedAt])
}
