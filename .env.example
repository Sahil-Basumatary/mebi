# Clerk authentication (added in M3)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
CLERK_WEBHOOK_SECRET=

# PostgreSQL via Vercel Postgres / Neon (added in M4)
DATABASE_URL=

# Vercel Blob store for avatar uploads (added in M10)
BLOB_READ_WRITE_TOKEN=

# AI provider for CV generation (added in M11)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional. Confirmation mail for the marketing waitlist and support inbox (Resend).
# Signups and contact messages still persist without these. Use a from-address on a domain you verified in Resend.
RESEND_API_KEY=
RESEND_FROM=
SUPPORT_INBOX=support@hackollab.com

# Optional public origin for email links. Falls back to the Vercel URL.
NEXT_PUBLIC_APP_URL=

# Required for weekly digest cron, contact retention, and AI ops cleanup.
CRON_SECRET=

# Optional. Server-side beta Pro grants and global AI kill switch.
# POST /api/admin/ops with Authorization: Bearer $PRO_GRANT_SECRET
PRO_GRANT_SECRET=

# GitHub App (read-only selected repositories). Never commit the private key.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
NEXT_PUBLIC_GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Inngest (repository sync and push indexing). Use the Inngest dashboard keys on Vercel.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Paid AI providers only. Private repository content must never use free provider tiers.
GOOGLE_AI_API_KEY=
AI_GLOBAL_BUDGET_USD_MICROS=40000000
