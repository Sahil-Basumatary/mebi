# Clerk authentication (added in M3)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
CLERK_WEBHOOK_SECRET=

# PostgreSQL via Vercel Postgres / Neon (added in M4)
DATABASE_URL=

# Vercel Blob store for avatar uploads (added in M10)
BLOB_READ_WRITE_TOKEN=

# AI provider for CV generation (added in M11)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional. Confirmation mail for the marketing waitlist (Resend).
# Signups still persist without these. Use a from-address on a domain you verified in Resend.
RESEND_API_KEY=
RESEND_FROM=

# Optional public origin for email links. Falls back to the Vercel URL.
NEXT_PUBLIC_APP_URL=

# Required for weekly digest cron and product-update sends.
CRON_SECRET=
